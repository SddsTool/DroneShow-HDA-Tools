// ==========================================
// 機体数の設定
// ==========================================
int max_count = chi("drone_count"); 
if (@ptnum >= max_count) {removepoint(0, @ptnum);} // 定員オーバーした機体を削除



// ==========================================
// 離陸
// ==========================================
float flight      = ch("flight_control"); // 0.0 -> 1.0 (全体のマスタースライダー)
float lift_height = ch("lift_height");    // 上昇する高さ
float pitch       = ch("grid_pitch");     // 配置間隔 (例: 1.5)
int row_step = chi("row_step"); // 何行おきに飛ばすか (Z軸方向)
int col_step = chi("col_step"); // 何列おきに飛ばすか (X軸方向)
float row_lag = ch("row_lag");  // 行ごとの遅れ時間
float col_lag = ch("col_lag");  // 列ごとの遅れ時間

vector target_color = @Cd;

float current_amount    = ch("blink_amount");    // 点滅の強さ (0=OFF, 1=ON)
float current_intensity = ch("intensity");       // 全体の明るさ
float current_freq      = ch("blink_freq");      // 点滅スピード
float current_rnd       = ch("blink_randomness");// 0.0=一斉, 1.0以上=バラバラ

vector pos = (v@rest != {0,0,0}) ? v@rest : @P;

int ix = int(floor(pos.x / pitch + 0.5)) + 10000;
int iz = int(floor(pos.z / pitch + 0.5)) + 10000;

int safe_col_step = max(1, col_step);
int safe_row_step = max(1, row_step);

int group_x = ix % safe_col_step;
int group_z = iz % safe_row_step;

float my_start_time = (group_z * row_lag) + (group_x * col_lag);
float max_delay = ((safe_row_step - 1) * row_lag) + ((safe_col_step - 1) * col_lag);
float move_dur  = max(1.0 - max_delay, 0.1);

float t = 0;
if (flight > my_start_time) {t = (flight - my_start_time) / move_dur;}
t = clamp(t, 0.0, 1.0);
float sub_t = chramp("motion_curve", t); 

vector start_p = pos;
vector end_p   = pos + set(0, lift_height, 0);
@P = lerp(start_p, end_p, sub_t);

vector my_look = {0, 0, 1};
vector my_up   = {0, 1, 0};    
@orient = quaternion(matrix3(lookat({0,0,0}, my_look, my_up)));

float phase_offset = rand(@ptnum) * 10.0 * current_rnd;
float wave = sin(@Time * current_freq + phase_offset) * 0.35 + 0.65;
float blink_val = lerp(1.0, wave, current_amount);

@Cd = target_color * blink_val * current_intensity;



// ==========================================
// 着陸
// ==========================================
float flight      = ch("flight_control"); 
float lift_height = ch("lift_height");    
float grid_pitch  = ch("grid_pitch");
float switch_val  = ch("switch_threshold");   

flight = min(flight, switch_val);

float intensity   = ch("intensity");      
int   row_step    = chi("row_step");
float row_lag     = ch("row_lag");
int   col_step    = chi("col_step");
float col_lag     = ch("col_lag");

vector base_pos = @P;

if (npoints(1) > 0) {int tgt_pt = nearpoint(1, @P);
    base_pos = point(1, "P", tgt_pt);}

vector hover_pos = set(base_pos.x, lift_height, base_pos.z);

float ground_y = 0.0;
if (v@rest != {0,0,0}) ground_y = v@rest.y;
vector ground_pos = set(base_pos.x, ground_y, base_pos.z);

int ix = int(floor(ground_pos.x / grid_pitch + 0.5)) + 10000;
int iz = int(floor(ground_pos.z / grid_pitch + 0.5)) + 10000;

int safe_row_step = max(1, row_step);
int safe_col_step = max(1, col_step);

int group_z = iz % safe_row_step;
int group_x = ix % safe_col_step;

float my_start_time = (group_z * row_lag) + (group_x * col_lag);
float max_delay = ((safe_row_step - 1) * row_lag) + ((safe_col_step - 1) * col_lag);
float move_dur  = max(1.0 - max_delay, 0.1);

float t = 0;
if (flight > my_start_time) {
   t = (flight - my_start_time) / move_dur;}
 　t = clamp(t, 0.0, 1.0);
float sub_t = chramp("motion_curve", t); 

float blink_freq  = ch("blink_freq");    
float blink_amt   = ch("blink_amount");  

if (flight < switch_val) {@P = lerp(ground_pos, hover_pos, sub_t);
float wave = 1.0;

if (blink_amt > 0.001) {wave = sin(@Time * blink_freq + @ptnum * 0.5) * 0.5 + 0.5;}
float blink_val = lerp(1.0, wave, blink_amt);
@Cd = @Cd * blink_val * intensity;

vector my_look = {0, 0, 1}; 
vector my_up   = {0, 1, 0}; 

@orient = quaternion(matrix3(lookat({0,0,0}, my_look, my_up)));}




