// ==========================================
// グループ毎の移動と点灯制御
// ==========================================
float global_move   = ch("Move"); 
float base_pscale   = chf("base_pscale");
float current_amount    = ch("default_amount");
float current_intensity = ch("default_intensity"); 
float current_freq      = ch("default_blink_freq"); 
float current_rnd       = ch("default_blink_rnd"); 
float my_move_prog      = global_move;

int current_move_color_enable = chi("default_move_color_enable");
vector current_move_color     = chv("default_move_color");

vector target_color = {1,1,1};
int def_color_mode = chi("default_color_mode");

if (def_color_mode == 0) {
    if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum);
    else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum);
} else if (def_color_mode == 1) {
    if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd;
    else if (haspointattrib(0, "Cd")) target_color = v@Cd;
} else if (def_color_mode == 2) {
    vector temp_target = point(1, "target_P", @ptnum);
    if (haspointattrib(1, "target_P") == 0) temp_target = point(1, "P", @ptnum);
    int ae_pt = nearpoint(2, temp_target);
    if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt);
}

float calculate_wave(vector target_pos; float curve_u; string axis; float progress; float pulse_time; float width; float boost; int count) {
    
    float safe_width = max(width, 0.0001);

    vector rel = relbbox(1, target_pos);
    float axis_value = rel.x;

    if (axis == "Y" || axis == "y") {
        axis_value = rel.y;
    } else if (axis == "Z" || axis == "z") {
        axis_value = rel.z;
    } else if (axis == "XY" || axis == "xy") {
        axis_value = (rel.x + rel.y) * 0.5;
    } else if (axis == "-XY" || axis == "-xy") {
        axis_value = ((1.0 - rel.x) + rel.y) * 0.5;
    } else if (axis == "C" || axis == "c") {
        // ★ 中心(0.5, 0.5, 0.5)から外側へ広がる波（円弧補間みたいな波紋）
        float d = distance(rel, set(0.5, 0.5, 0.5));
        axis_value = fit(d, 0.0, 0.866025, 0.0, 1.0);
    } else if (axis == "-C" || axis == "-c") {
        // ★ 外側から中心へ向かって収縮する波
        float d = distance(rel, set(0.5, 0.5, 0.5));
        axis_value = fit(d, 0.0, 0.866025, 1.0, 0.0);
    } else if (axis == "U" || axis == "u") {
        axis_value = curve_u;
    } else if (axis == "O" || axis == "o") {
        float noise_val = snoise(target_pos * 0.05) * 0.2; 
        axis_value = clamp(rel.y + noise_val, 0.0, 1.0);
    }
    
    float nx = clamp(axis_value, 0.0, 1.0);

    // --- 1. ベースの点灯 ---
    float base_intensity = 0.0;
    if (progress > 0.0001) {
        base_intensity = (nx <= progress) ? 1.0 : 0.0;}

    // --- 2. 強く光る波（複数回パルス対応） ---
    float pulse_intensity = 0.0;
    if (pulse_time >= 0.0 && pulse_time <= (float)count) {
        float loop_time = frac(pulse_time);
        if (pulse_time >= (float)count) loop_time = 1.0;

        float pulse_pos = fit(loop_time, 0.0, 1.0, -safe_width, 1.0 + safe_width);
        float distance_val = abs(nx - pulse_pos);
        
        if(distance_val < safe_width) {
            float ratio = distance_val / safe_width; 
            pulse_intensity = sin((1.0 - ratio) * PI) * boost; }}
return base_intensity + pulse_intensity;}

vector p_start = @P;
vector start_color = @Cd;

vector p_target_base = point(1, "target_P", @ptnum);
if (haspointattrib(1, "target_P") == 0) p_target_base = point(1, "P", @ptnum);

vector p_target_rig = p_target_base;
i@target_pt = point(1, "target_pt", @ptnum);
int has_rig = (npoints(3) > 0 && i@target_pt >= 0);

if (has_rig) {p_target_rig = point(3, "P", i@target_pt);}

int default_use_rig = chi("default_use_rig");
vector p_target = (default_use_rig == 1 && has_rig) ? p_target_rig : p_target_base;

f@curveu = 0.0;
if (haspointattrib(1, "curveu")) {f@curveu = point(1, "curveu", @ptnum);}

string grp1 = chs("group1_name");  string grp2 = chs("group2_name");
string grp3 = chs("group3_name");  string grp4 = chs("group4_name");
string grp5 = chs("group5_name");  string grp6 = chs("group6_name");
string grp7 = chs("group7_name");  string grp8 = chs("group8_name");
string grp9 = chs("group9_name");  string grp10 = chs("group10_name");
string grp11 = chs("group11_name"); string grp12 = chs("group12_name");
string grp13 = chs("group13_name"); string grp14 = chs("group14_name");
string grp15 = chs("group15_name"); string grp16 = chs("group16_name");
string grp17 = chs("group17_name"); string grp18 = chs("group18_name");

// ---  Group 1 ---
if (strlen(grp1) > 0 && inpointgroup(1, grp1, @ptnum)) {
    int use_rig1 = chi("use_rig1");
    p_target = (use_rig1 == 1 && has_rig) ? p_target_rig : p_target_base;

    current_amount    = ch("amount1");
    current_intensity = ch("intensity1");
    current_freq      = ch("blink_freq1");
    current_rnd       = ch("blink_rnd1");
    my_move_prog      = ch("move_grp1");
    current_move_color_enable = chi("move_color_enable1");
    current_move_color        = chv("move_color1");
    
    int mode1 = chi("color_mode1");
    if (mode1 == 0) {
        if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum);
        else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum);}
        else if (mode1 == 1) {
        if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd;
        else if (haspointattrib(0, "Cd")) target_color = v@Cd;}
        else if (mode1 == 2) {int ae_pt = nearpoint(2, p_target);
        if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt);}

    if (chi("wave1_enable")) {
        current_intensity *= calculate_wave(
            p_target, f@curveu, chs("wave1_axis"), 
            ch("wave1_progress"), ch("wave1_pulse_time"), ch("wave1_width"), ch("wave1_boost"), chi("wave1_count"));}}

// ---  Group 2 ---
else if (strlen(grp2) > 0 && inpointgroup(1, grp2, @ptnum)) {
    int use_rig2 = chi("use_rig2");
    p_target = (use_rig2 == 1 && has_rig) ? p_target_rig : p_target_base;
    current_amount    = ch("amount2"); current_intensity = ch("intensity2");
    current_freq      = ch("blink_freq2"); current_rnd       = ch("blink_rnd2");
    my_move_prog      = ch("move_grp2"); current_move_color_enable = chi("move_color_enable2");
    current_move_color        = chv("move_color2");
    int mode2 = chi("color_mode2");
    if (mode2 == 0) { if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum); else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum); }
    else if (mode2 == 1) { if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd; else if (haspointattrib(0, "Cd")) target_color = v@Cd; }
    else if (mode2 == 2) { int ae_pt = nearpoint(2, p_target); if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt); }

    if (chi("wave2_enable")) {
        current_intensity *= calculate_wave(p_target, f@curveu, chs("wave2_axis"), ch("wave2_progress"), ch("wave2_pulse_time"), ch("wave2_width"), ch("wave2_boost"), chi("wave2_count"));}}

