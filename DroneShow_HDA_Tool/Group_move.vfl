    my_move_prog = ch("move_grp14"); current_move_color_enable = chi("move_color_enable14"); current_move_color = chv("move_color14");
    int mode14 = chi("color_mode14");
    if (mode14 == 0) { if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum); else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum); }
    else if (mode14 == 1) { if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd; else if (haspointattrib(0, "Cd")) target_color = v@Cd; }
    else if (mode14 == 2) { int ae_pt = nearpoint(2, p_target); if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt); }

    if (chi("wave14_enable")) {
        current_intensity *= calculate_wave(p_target, f@curveu, chs("wave14_axis"), ch("wave14_progress"), ch("wave14_pulse_time"), ch("wave14_width"), ch("wave14_boost"), chi("wave14_count"));}}

// ---  Group 15 ---
else if (strlen(grp15) > 0 && inpointgroup(1, grp15, @ptnum)) {
    int use_rig15 = chi("use_rig15"); p_target = (use_rig15 == 1 && has_rig) ? p_target_rig : p_target_base;
    current_amount = ch("amount15"); current_intensity = ch("intensity15"); current_freq = ch("blink_freq15"); current_rnd = ch("blink_rnd15");
    my_move_prog = ch("move_grp15"); current_move_color_enable = chi("move_color_enable15"); current_move_color = chv("move_color15");
    int mode15 = chi("color_mode15");
    if (mode15 == 0) { if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum); else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum); }
    else if (mode15 == 1) { if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd; else if (haspointattrib(0, "Cd")) target_color = v@Cd; }
    else if (mode15 == 2) { int ae_pt = nearpoint(2, p_target); if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt); }

    if (chi("wave15_enable")) {
        current_intensity *= calculate_wave(p_target, f@curveu, chs("wave15_axis"), ch("wave15_progress"), ch("wave15_pulse_time"), ch("wave15_width"), ch("wave15_boost"), chi("wave15_count"));}}

// ---  Group 16 ---
else if (strlen(grp16) > 0 && inpointgroup(1, grp16, @ptnum)) {
    int use_rig16 = chi("use_rig16"); p_target = (use_rig16 == 1 && has_rig) ? p_target_rig : p_target_base;
    current_amount = ch("amount16"); current_intensity = ch("intensity16"); current_freq = ch("blink_freq16"); current_rnd = ch("blink_rnd16");
    my_move_prog = ch("move_grp16"); current_move_color_enable = chi("move_color_enable16"); current_move_color = chv("move_color16");
    int mode16 = chi("color_mode16");
    if (mode16 == 0) { if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum); else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum); }
    else if (mode16 == 1) { if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd; else if (haspointattrib(0, "Cd")) target_color = v@Cd; }
    else if (mode16 == 2) { int ae_pt = nearpoint(2, p_target); if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt); }

    if (chi("wave16_enable")) {
        current_intensity *= calculate_wave(p_target, f@curveu, chs("wave16_axis"), ch("wave16_progress"), ch("wave16_pulse_time"), ch("wave16_width"), ch("wave16_boost"), chi("wave16_count"));}}

// ---  Group 17 ---
else if (strlen(grp17) > 0 && inpointgroup(1, grp17, @ptnum)) {
    int use_rig17 = chi("use_rig17"); p_target = (use_rig17 == 1 && has_rig) ? p_target_rig : p_target_base;
    current_amount = ch("amount17"); current_intensity = ch("intensity17"); current_freq = ch("blink_freq17"); current_rnd = ch("blink_rnd17");
    my_move_prog = ch("move_grp17"); current_move_color_enable = chi("move_color_enable17"); current_move_color = chv("move_color17");
    int mode17 = chi("color_mode17");
    if (mode17 == 0) { if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum); else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum); }
    else if (mode17 == 1) { if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd; else if (haspointattrib(0, "Cd")) target_color = v@Cd; }
    else if (mode17 == 2) { int ae_pt = nearpoint(2, p_target); if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt); }

    if (chi("wave17_enable")) {
        current_intensity *= calculate_wave(p_target, f@curveu, chs("wave17_axis"), ch("wave17_progress"), ch("wave17_pulse_time"), ch("wave17_width"), ch("wave17_boost"), chi("wave17_count"));}}
        
// ---  Group 18 ---
else if (strlen(grp18) > 0 && inpointgroup(1, grp18, @ptnum)) {
    int use_rig18 = chi("use_rig18"); p_target = (use_rig18 == 1 && has_rig) ? p_target_rig : p_target_base;
    current_amount = ch("amount18"); current_intensity = ch("intensity18"); current_freq = ch("blink_freq18"); current_rnd = ch("blink_rnd18");
    my_move_prog = ch("move_grp18"); current_move_color_enable = chi("move_color_enable18"); current_move_color = chv("move_color18");
    int mode18 = chi("color_mode18");
    if (mode18 == 0) { if (haspointattrib(1, "target_Cd")) target_color = point(1, "target_Cd", @ptnum); else if (haspointattrib(1, "Cd")) target_color = point(1, "Cd", @ptnum); }
    else if (mode18 == 1) { if (haspointattrib(0, "target_Cd")) target_color = v@target_Cd; else if (haspointattrib(0, "Cd")) target_color = v@Cd; }
    else if (mode18 == 2) { int ae_pt = nearpoint(2, p_target); if (ae_pt >= 0 && haspointattrib(2, "Cd")) target_color = point(2, "Cd", ae_pt); }

    if (chi("wave18_enable")) {
        current_intensity *= calculate_wave(p_target, f@curveu, chs("wave18_axis"), ch("wave18_progress"), ch("wave18_pulse_time"), ch("wave18_width"), ch("wave18_boost"), chi("wave18_count"));}}

float phase_offset = rand(@ptnum) * 10.0 * current_rnd;
float wave = sin(@Time * current_freq + phase_offset) * 0.35 + 0.65;
float blink_val = lerp(1.0, wave, current_amount);

blink_val = max(0.0, blink_val);

vector final_target_col = target_color * blink_val * current_intensity;

my_move_prog = clamp(my_move_prog, 0.0, 1.0);
float t = chramp("Motion_Curve", my_move_prog);

@Cd = lerp(start_color, final_target_col, clamp(my_move_prog * 10.0, 0, 1));
if (my_move_prog > 0.01) {@Cd = lerp(start_color, final_target_col, my_move_prog);}

float move_mask = sin(my_move_prog * PI);
vector base_move_color;

if (current_move_color_enable == 1) {base_move_color = current_move_color;} 
else {base_move_color = lerp(start_color, target_color, my_move_prog);}

vector active_move_color = base_move_color * blink_val;

@Cd = lerp(@Cd, active_move_color, move_mask);

@P = lerp(p_start, p_target, t);
@pscale = base_pscale;